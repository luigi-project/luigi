{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "esnext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "#lib": [
        "./src/lib"
      ],
      "#lib/*": [
        "./src/lib/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "include": [
    "./vite.config.ts",
    "./src/**/*.js",
    "./src/**/*.ts",
    "./src/**/*.svelte",
    "./test/**/*.js",
    "./test/**/*.ts",
    "./test/**/*.svelte",
    "./tests/**/*.js",
    "./tests/**/*.ts",
    "./tests/**/*.svelte"
  ],
  "exclude": [
    "./node_modules/**",
    "./src/service-worker.js",
    "./src/service-worker/**/*.js",
    "./src/service-worker.ts",
    "./src/service-worker/**/*.ts",
    "./src/service-worker.d.ts",
    "./src/service-worker/**/*.d.ts"
  ]
}